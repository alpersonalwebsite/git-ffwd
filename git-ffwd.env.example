# Copy to ~/.git-ffwd.env and edit. Sourced by run_git-ffwd.sh with `set -a`,
# so plain assignments are exported automatically.
#
# This file holds paths and tuning only. It must never hold a token, password,
# or any other secret -- git auth comes from your ssh key or a credential
# helper, never from here.

# Folders to scan, colon-separated. Repos are expected as direct children.
# On macOS, a root under ~/Documents, ~/Desktop or ~/Downloads can only be
# reached by cron, never by a Launch Agent. See README, "macOS TCC".
GIT_FFWD_ROOTS="$HOME/repos"

# find -maxdepth when hunting for .git. 2 = repos are direct children of a root,
# which also keeps submodules (depth 3) out of the list.
GIT_FFWD_DEPTH=2

# Repos processed concurrently.
GIT_FFWD_JOBS=4

# Seconds per network call, per repo. Needs timeout(1) -- brew install coreutils.
GIT_FFWD_TIMEOUT=120

# fetch    advance the default branch without checking it out (safe, default)
# checkout check the branch out and merge --ff-only
GIT_FFWD_MODE=fetch

# Optional folder-name globs, comma-separated. Exclude wins over include.
# GIT_FFWD_INCLUDE="api-*,infra-*"
# GIT_FFWD_EXCLUDE="*-archive,scratch"

# Lock identity for the WORKER lock, which serialises the fetching. A second
# scheduled job over different roots needs its own name. The wrapper's lock is
# keyed on GIT_FFWD_LOG instead, because what it protects is $LOG.tmp.
# GIT_FFWD_LOCK_NAME=git-ffwd

# Re-ask each remote which branch is HEAD on every run. Costs one extra round
# trip per repo; only needed after an upstream default-branch rename.
# GIT_FFWD_REFRESH_DEFAULT=1

# Log the wrapper trims and the scheduler appends to. These MUST agree with
# whatever the crontab line or plist redirects to, or the trim hits the wrong
# file: nothing is ever trimmed, or a run's output is trimmed away.
# GIT_FFWD_LABEL=com.user.GitFastForward
# GIT_FFWD_LOG="$HOME/Library/Logs/com.user.GitFastForward.log"
# For a CRON job the scheduler usually derives the log from the script basename
# (run_git-ffwd.log). Set this to whatever the crontab line redirects to, or the
# trim runs on a file nothing writes to and the real log grows forever.
# GIT_FFWD_LOG_LINES=2000

# Options appended to whatever core.sshCommand each repo resolves to. BatchMode
# must stay on: it turns a credential prompt into a fast failure rather than a
# job that hangs until the next scheduled run piles up behind it.
# GIT_FFWD_SSH_OPTIONS="-o BatchMode=yes -o ConnectTimeout=10"

# Replace the ssh command outright for every repo. This DISCARDS per-repo
# identity selection (~/.gitconfig includeIf -> core.sshCommand -i <key>), so
# only set it if every repo really does use the same key.
# GIT_FFWD_SSH_COMMAND="ssh -i $HOME/.ssh/id_ed25519_automation -o BatchMode=yes"
